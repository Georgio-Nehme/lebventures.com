# Public API endpoint — must be reachable by the browser
NEXT_PUBLIC_API_URL=https://api.lebventures.com

# Cognito region
NEXT_PUBLIC_COGNITO_REGION=eu-central-1

# Cognito App Client ID
NEXT_PUBLIC_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Public website URL — used for "View site" links and resolving site-relative image previews
NEXT_PUBLIC_SITE_URL=https://lebventures.com
