---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getContent, lines, show, isExternalHref } from '../data/content';
import '../styles/global.css';

const c = await getContent();
const cardsClickable = show(c, 'home.offer.cards.link.show');

const featuredAdventures = [
  { icon: 'hiking', key: 'card1', hrefKey: 'home.offer.card1.href' },
  { icon: 'water', key: 'card2', hrefKey: 'home.offer.card2.href' },
  { icon: 'kids', key: 'card3', hrefKey: 'home.offer.card3.href' },
];
---

<BaseLayout
  title="LebVentures — For the Love of Nature"
  description="LebVentures is a family-founded adventure tour operator based in Byblos, Lebanon. Founded in 2019 by Pierre Abboud and Gioia Wehbe, we offer hiking, camping, kayaking, snowshoeing, rock climbing, kids adventures, and more across Lebanon's stunning landscapes."
  keywords="adventure tourism Lebanon, hiking Lebanon, kayaking Lebanon, camping Lebanon, kids outdoor activities Lebanon, sustainable tourism Byblos, LebVentures, Pierre Abboud, Gioia Wehbe"
>
  <Navbar transparent={true} />
  <main>

    <!-- Hero with banner image -->
    <Hero
      useBanner={true}
      prefix="home.hero"
      tagline={c['home.hero.tagline']}
      heading={lines(c['home.hero.heading'])}
      subheading={c['home.hero.subheading']}
      primaryCta={{ label: c['home.hero.cta_primary'], href: '/adventures' }}
      secondaryCta={{ label: c['home.hero.cta_secondary'], href: '/contact' }}
      ctaPrimaryKey="home.hero.cta_primary"
      ctaSecondaryKey="home.hero.cta_secondary"
      ctaPrimaryShowKey="home.hero.cta_primary.show"
      ctaSecondaryShowKey="home.hero.cta_secondary.show"
      ctaPrimaryHrefKey="home.hero.cta_primary.href"
      ctaSecondaryHrefKey="home.hero.cta_secondary.href"
      statsShowKey="home.hero.stats.show"
      stats={[
        { value: c['home.hero.stat1.value'], label: c['home.hero.stat1.label'] },
        { value: c['home.hero.stat2.value'], label: c['home.hero.stat2.label'] },
        { value: c['home.hero.stat3.value'], label: c['home.hero.stat3.label'] },
      ]}
    />

    <!-- Featured adventures snippet -->
    <section class="py-20 bg-white" aria-labelledby="featured-heading" data-c-show="home.offer.show" hidden={!show(c, 'home.offer.show')}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 id="featured-heading" class="section-heading" data-c="home.offer.heading">{c['home.offer.heading']}</h2>
          <p class="section-subheading mx-auto" data-c="home.offer.subheading" data-c-multiline>{c['home.offer.subheading']}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {featuredAdventures.map(adv => (
            <a
              href={cardsClickable ? c[adv.hrefKey] : undefined}
              data-href={c[adv.hrefKey]}
              data-c-href={adv.hrefKey}
              data-c-link="home.offer.cards.link.show"
              aria-disabled={cardsClickable ? undefined : 'true'}
              target={cardsClickable && isExternalHref(c[adv.hrefKey]) ? '_blank' : undefined}
              rel={cardsClickable && isExternalHref(c[adv.hrefKey]) ? 'noopener noreferrer' : undefined}
              class="group p-6 rounded-2xl border border-brand-sky bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
            >
              <div class="mb-4 text-brand-primary">
                <Icon name={adv.icon} class="w-14 h-14" />
              </div>
              <h3 class="text-xl font-heading font-bold text-brand-primary mb-2 group-hover:text-brand-olive transition-colors" data-c={`home.offer.${adv.key}.title`}>
                {c[`home.offer.${adv.key}.title`]}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed" data-c={`home.offer.${adv.key}.desc`} data-c-multiline>{c[`home.offer.${adv.key}.desc`]}</p>
              <span class="inline-block mt-4 text-brand-primary text-sm font-semibold group-hover:underline" data-c-show="home.offer.cards.link.show" hidden={!cardsClickable}>
                Learn more →
              </span>
            </a>
          ))}
        </div>
        <div class="text-center mt-10" data-c-show="home.offer.cta.show" hidden={!show(c, 'home.offer.cta.show')}>
          <a
            href={c['home.offer.cta.href']}
            class="btn-outline"
            data-c="home.offer.cta"
            data-c-href="home.offer.cta.href"
            target={isExternalHref(c['home.offer.cta.href']) ? '_blank' : undefined}
            rel={isExternalHref(c['home.offer.cta.href']) ? 'noopener noreferrer' : undefined}
          >{c['home.offer.cta']}</a>
        </div>
      </div>
    </section>

    <!-- About snippet -->
    <section class="py-20 bg-brand-sky/30" aria-labelledby="about-snippet-heading" data-c-show="home.story.show" hidden={!show(c, 'home.story.show')}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="inline-block text-xs font-bold text-brand-primary uppercase tracking-widest mb-3">Our Story</span>
            <h2 id="about-snippet-heading" class="section-heading" data-c-html="home.story.heading" set:html={lines(c['home.story.heading'])} />
            <p class="text-gray-600 leading-relaxed mb-6" data-c="home.story.p1" data-c-multiline>
              {c['home.story.p1']}
            </p>
            <p class="text-gray-600 leading-relaxed mb-8" data-c="home.story.p2" data-c-multiline>
              {c['home.story.p2']}
            </p>
            <a
              href={c['home.story.cta.href']}
              class="btn-primary"
              data-c="home.story.cta"
              data-c-show="home.story.cta.show"
              hidden={!show(c, 'home.story.cta.show')}
              data-c-href="home.story.cta.href"
              target={isExternalHref(c['home.story.cta.href']) ? '_blank' : undefined}
              rel={isExternalHref(c['home.story.cta.href']) ? 'noopener noreferrer' : undefined}
            >{c['home.story.cta']}</a>
          </div>
          <div class="relative rounded-3xl overflow-hidden bg-brand-primary shadow-2xl min-h-64">
            <!-- Team photo — drop /images/team.jpg to activate -->
            <img
              src={c['home.story.image']}
              alt="Pierre Abboud and Gioia Wehbe — LebVentures founders on a mountain trail"
              class="absolute inset-0 w-full h-full object-cover object-center"
              loading="lazy"
              onerror="this.remove()"
              data-c-src="home.story.image"
            />
            <!-- Overlay keeps text readable with or without a photo -->
            <div class="absolute inset-0 bg-gradient-to-br from-brand-dark/80 via-brand-dark/60 to-brand-primary/50"></div>
            <!-- Content -->
            <div class="relative z-10 p-8 text-white">
              <div class="flex justify-center mb-5 opacity-80">
                <Icon name="scout" class="w-16 h-16 text-brand-gold" />
              </div>
              <blockquote class="text-lg font-heading italic leading-relaxed text-center mb-6">
                "<span data-c="home.story.quote" data-c-multiline>{c['home.story.quote']}</span>"
              </blockquote>
              <div class="flex items-center justify-center gap-3">
                <div class="w-10 h-10 rounded-full bg-brand-gold flex items-center justify-center text-brand-dark font-bold text-sm">LV</div>
                <div>
                  <div class="font-bold text-sm" data-c="home.story.founders">{c['home.story.founders']}</div>
                  <div class="text-brand-sky text-xs" data-c="home.story.founders_sub">{c['home.story.founders_sub']}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sustainable Tourism snippet -->
    <section class="py-20 bg-white" aria-labelledby="eco-snippet-heading" data-c-show="home.eco.show" hidden={!show(c, 'home.eco.show')}>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block text-xs font-bold text-brand-primary uppercase tracking-widest mb-3">Sustainability</span>
        <h2 id="eco-snippet-heading" class="section-heading" data-c="home.eco.heading">{c['home.eco.heading']}</h2>
        <p class="section-subheading mx-auto mb-10" data-c="home.eco.subheading" data-c-multiline>
          {c['home.eco.subheading']}
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">
          {[
            { icon: 'leaf', key: 'pillar1' },
            { icon: 'house', key: 'pillar2' },
            { icon: 'cedar', key: 'pillar3' },
            { icon: 'book', key: 'pillar4' },
          ].map(p => (
            <div class="flex flex-col items-center gap-3 p-4 rounded-xl bg-brand-sky/40">
              <div class="text-brand-primary">
                <Icon name={p.icon} class="w-10 h-10" />
              </div>
              <span class="text-sm font-semibold text-brand-primary" data-c={`home.eco.${p.key}`}>{c[`home.eco.${p.key}`]}</span>
            </div>
          ))}
        </div>
        <a
          href={c['home.eco.cta.href']}
          class="btn-outline"
          data-c="home.eco.cta"
          data-c-show="home.eco.cta.show"
          hidden={!show(c, 'home.eco.cta.show')}
          data-c-href="home.eco.cta.href"
          target={isExternalHref(c['home.eco.cta.href']) ? '_blank' : undefined}
          rel={isExternalHref(c['home.eco.cta.href']) ? 'noopener noreferrer' : undefined}
        >{c['home.eco.cta']}</a>
      </div>
    </section>

    <Community />

  </main>
  <Footer />
</BaseLayout>
