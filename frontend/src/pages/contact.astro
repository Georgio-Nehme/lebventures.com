---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getContent, show } from '../data/content';
import '../styles/global.css';

const c = await getContent();
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with LebVentures to plan a guided outdoor experience in Lebanon. Hiking, climbing, camping, heritage tours and more — we'll craft the perfect adventure for your group."
  keywords="contact LebVentures, guided tours Lebanon, adventure tours Lebanon"
>
  <Navbar />
  <main class="pt-16">

    <!-- Page header -->
    <div class="bg-brand-primary text-white py-16 text-center relative overflow-hidden">
      <img
        src={c['contact.header.image'] || undefined}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        data-c-src="contact.header.image"
        hidden={!c['contact.header.image']}
        loading="lazy"
      />
      <div class="absolute inset-0 bg-brand-dark/70" data-c-src-overlay="contact.header.image" hidden={!c['contact.header.image']}></div>
      <div class="max-w-2xl mx-auto px-4 relative z-10">
        <span class="inline-block text-xs font-bold text-brand-gold uppercase tracking-widest mb-3" data-c="contact.header.tagline">{c['contact.header.tagline']}</span>
        <h1 class="text-4xl md:text-5xl font-heading font-bold mb-4" data-c="contact.header.heading">{c['contact.header.heading']}</h1>
        <p class="text-white/80 text-lg leading-relaxed" data-c="contact.header.subheading" data-c-multiline>
          {c['contact.header.subheading']}
        </p>
      </div>
    </div>

    <Contact />

    <!-- Free discovery call -->
    <div class="bg-brand-primary/5 border-y border-brand-sky py-12" data-c-show="contact.call.show" hidden={!show(c, 'contact.call.show')}>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
        <span class="inline-block text-xs font-bold text-brand-gold uppercase tracking-widest mb-3" data-c="contact.call.tagline">{c['contact.call.tagline']}</span>
        <h2 class="font-heading font-bold text-brand-primary text-2xl md:text-3xl mb-3" data-c="contact.call.heading">{c['contact.call.heading']}</h2>
        <p class="text-gray-600 text-base leading-relaxed max-w-xl mx-auto mb-6" data-c="contact.call.text" data-c-multiline>
          {c['contact.call.text']}
        </p>
        <a
          href={c['contact.call.url']}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center gap-2 px-8 py-4 text-base"
          data-c-href="contact.call.url"
        >
          <span data-c="contact.call.button">{c['contact.call.button']}</span>
        </a>
        <p class="text-xs text-gray-400 mt-3" data-c="contact.call.note">{c['contact.call.note']}</p>
      </div>
    </div>

    <!-- Info strip -->
    <div class="bg-brand-sky/40 py-12" data-c-show="contact.info.show" hidden={!show(c, 'contact.info.show')}>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="flex justify-center mb-2 text-brand-primary">
            <Icon name="pin" class="w-10 h-10" />
          </div>
          <h3 class="font-heading font-bold text-brand-primary mb-1" data-c="contact.info.location.title">{c['contact.info.location.title']}</h3>
          <p class="text-sm text-gray-600" data-c="contact.info.location.text" data-c-multiline>{c['contact.info.location.text']}</p>
        </div>
        <div>
          <div class="flex justify-center mb-2 text-brand-primary">
            <Icon name="envelope" class="w-10 h-10" />
          </div>
          <h3 class="font-heading font-bold text-brand-primary mb-1" data-c="contact.info.email.title">{c['contact.info.email.title']}</h3>
          <a href={`mailto:${c['global.contact.email']}`} class="text-sm text-brand-primary hover:underline" data-c-href="global.contact.email" data-c-prefix="mailto:">
            <span data-c="global.contact.email">{c['global.contact.email']}</span>
          </a>
        </div>
        <div>
          <div class="flex justify-center mb-2 text-brand-primary">
            <Icon name="clock" class="w-10 h-10" />
          </div>
          <h3 class="font-heading font-bold text-brand-primary mb-1" data-c="contact.info.phone.title">{c['contact.info.phone.title']}</h3>
          <a href={`tel:${c['global.contact.phone_href']}`} class="text-sm text-brand-primary hover:underline" data-c-href="global.contact.phone_href" data-c-prefix="tel:">
            <span data-c="global.contact.phone">{c['global.contact.phone']}</span>
          </a>
        </div>
      </div>
    </div>

  </main>
  <Footer />
</BaseLayout>
