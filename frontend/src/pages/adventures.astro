---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Adventures from '../components/Adventures.astro';
import Footer from '../components/Footer.astro';
import { getContent, lines } from '../data/content';
import '../styles/global.css';

const c = await getContent();
---

<BaseLayout
  title="Adventures in Lebanon"
  description="Explore LebVentures' full range of outdoor adventures in Lebanon — hiking, rock climbing, camping, kayaking, snowshoeing, mountain biking, caving, stargazing, and kids educational experiences for all ages. Based in Byblos."
  keywords="hiking Lebanon, rock climbing Lebanon, camping Lebanon, kayaking Lebanon, snowshoeing Lebanon, mountain biking Lebanon, caving Lebanon, kids outdoor activities Lebanon, adventure tours Byblos, LebVentures"
>
  <Navbar />
  <main>
    <Hero
      prefix="adventures.hero"
      tagline={c['adventures.hero.tagline']}
      heading={lines(c['adventures.hero.heading'])}
      subheading={c['adventures.hero.subheading']}
      primaryCta={{ label: c['adventures.hero.cta'], href: '/contact' }}
      ctaPrimaryKey="adventures.hero.cta"
      ctaPrimaryShowKey="adventures.hero.cta.show"
      ctaPrimaryHrefKey="adventures.hero.cta.href"
    />
    <Adventures />
  </main>
  <Footer />
</BaseLayout>
