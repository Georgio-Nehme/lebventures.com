---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Ecotourism from '../components/Ecotourism.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getContent, lines } from '../data/content';
import '../styles/global.css';

const c = await getContent();

// Icons are not editable; text comes from content by index.
const COMMITMENT_ICONS = ['leaf', 'house', 'cedar', 'book', 'recycle', 'eagle'];
const commitments = COMMITMENT_ICONS.map((icon, i) => {
  const n = i + 1;
  return {
    icon,
    n,
    title: c[`sustainability.commitment${n}.title`],
    detail: c[`sustainability.commitment${n}.desc`],
  };
});
---

<BaseLayout
  title="Sustainable Tourism & Our Commitment"
  description="LebVentures is committed to responsible sustainable tourism in Lebanon. Discover our Leave No Trace principles, local community support, habitat protection, and educational approach to outdoor adventure."
  keywords="sustainable tourism Lebanon, Leave No Trace Lebanon, nature conservation Lebanon, responsible adventure Lebanon"
>
  <Navbar />
  <main>
    <Hero
      prefix="sustainability.hero"
      tagline={c['sustainability.hero.tagline']}
      heading={lines(c['sustainability.hero.heading'])}
      subheading={c['sustainability.hero.subheading']}
    />

    <Ecotourism />

    <!-- Extended commitments -->
    <section class="py-20 bg-white" aria-labelledby="commitments-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <h2 id="commitments-heading" class="section-heading" data-c="sustainability.commitments.heading">{c['sustainability.commitments.heading']}</h2>
          <p class="section-subheading mx-auto" data-c="sustainability.commitments.subheading" data-c-multiline>{c['sustainability.commitments.subheading']}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {commitments.map(item => (
            <div class="p-6 rounded-2xl border border-brand-sky hover:shadow-lg transition-shadow">
              <div class="mb-3 text-brand-primary">
                <Icon name={item.icon} class="w-12 h-12" />
              </div>
              <h3 class="font-heading font-bold text-brand-primary text-lg mb-2" data-c={`sustainability.commitment${item.n}.title`}>{item.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed" data-c={`sustainability.commitment${item.n}.desc`} data-c-multiline>{item.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-brand-primary text-white text-center">
      <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-3xl font-heading font-bold mb-4" data-c="sustainability.cta.heading">{c['sustainability.cta.heading']}</h2>
        <p class="text-white/80 mb-8" data-c="sustainability.cta.text" data-c-multiline>{c['sustainability.cta.text']}</p>
        <a href="/contact" class="btn-primary bg-brand-gold text-brand-dark hover:bg-yellow-400 px-10 py-4 text-base" data-c="sustainability.cta.button">{c['sustainability.cta.button']}</a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
