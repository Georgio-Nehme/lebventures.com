---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { getContent, lines } from '../data/content';
import '../styles/global.css';

const c = await getContent();

const timeline = [1, 2, 3, 4, 5].map(n => ({
  n,
  year: c[`about.timeline.item${n}.year`],
  event: c[`about.timeline.item${n}.text`],
}));
---

<BaseLayout
  title="About LebVentures — Pierre Abboud & Gioia Wehbe"
  description="Meet Pierre Abboud and Gioia Wehbe, the scout alumni couple behind LebVentures — a family-founded adventure tour operator based in Byblos, Lebanon, rooted in a lifelong love for the outdoors."
  keywords="LebVentures founders, Pierre Abboud, Gioia Wehbe, Lebanese scouts, about LebVentures, adventure guides Lebanon, sustainable tourism Byblos Lebanon"
>
  <Navbar />
  <main>
    <Hero
      prefix="about.hero"
      tagline={c['about.hero.tagline']}
      heading={lines(c['about.hero.heading'])}
      subheading={c['about.hero.subheading']}
    />

    <About />

    <!-- Founders timeline -->
    <section class="py-20 bg-brand-sky/30" aria-labelledby="timeline-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <h2 id="timeline-heading" class="section-heading" data-c="about.timeline.heading">{c['about.timeline.heading']}</h2>
          <p class="section-subheading mx-auto" data-c="about.timeline.subheading" data-c-multiline>{c['about.timeline.subheading']}</p>
        </div>
        <ol class="relative border-l-2 border-brand-primary space-y-10 ml-4">
          {timeline.map((item, i) => (
            <li class="ml-6">
              <span class="absolute -left-3.5 flex h-7 w-7 items-center justify-center rounded-full bg-brand-primary text-white text-xs font-bold ring-4 ring-white">
                {i + 1}
              </span>
              <div class="flex flex-col gap-1">
                <span class="inline-block bg-brand-gold text-brand-dark text-xs font-bold px-2 py-0.5 rounded w-fit" data-c={`about.timeline.item${item.n}.year`}>{item.year}</span>
                <p class="text-gray-700 text-sm leading-relaxed mt-1" data-c={`about.timeline.item${item.n}.text`} data-c-multiline>{item.event}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-white text-center">
      <div class="max-w-xl mx-auto px-4">
        <h2 class="section-heading" data-c="about.cta.heading">{c['about.cta.heading']}</h2>
        <p class="section-subheading mx-auto mb-8" data-c="about.cta.text" data-c-multiline>{c['about.cta.text']}</p>
        <a href="/contact" class="btn-primary px-10 py-4 text-base" data-c="about.cta.button">{c['about.cta.button']}</a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
