---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Website Content">
  <!-- Auth guard runs before any content renders -->
  <script>
    if (!sessionStorage.getItem('lv_id_token')) {
      window.location.replace('/admin');
    }
  </script>

  <div class="min-h-screen bg-gray-50">

    <!-- Top nav -->
    <header class="bg-brand-dark text-white px-6 py-4 flex items-center justify-between shadow-md">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-brand-gold flex items-center justify-center">
          <span class="text-brand-dark font-bold text-xs">LV</span>
        </div>
        <span class="font-heading font-bold text-lg">LebVentures Admin</span>
      </div>
      <div class="flex items-center gap-4">
        <span id="admin-email" class="text-brand-lime text-sm hidden"></span>
        <button id="logout-btn" class="text-sm bg-white/10 hover:bg-white/20 px-4 py-1.5 rounded-lg transition-colors">
          Sign Out
        </button>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 pb-28">

      <!-- Page header -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
        <div>
          <h1 class="text-2xl font-heading font-bold text-brand-dark">Website Content</h1>
          <p class="text-gray-500 text-sm mt-0.5">Edit the texts and images shown on the public site</p>
        </div>
        <div class="flex items-center gap-4">
          <a href="/admin/dashboard" class="text-sm text-gray-500 hover:text-brand-dark font-medium transition-colors">
            ← Events
          </a>
          <a href="/" target="_blank" rel="noopener" class="text-sm text-brand-primary hover:text-brand-olive font-semibold transition-colors">
            View site ↗
          </a>
        </div>
      </div>

      <!-- Status banner -->
      <div id="status-banner" class="hidden mb-6 p-4 rounded-xl text-sm font-medium"></div>

      <!-- Loading state -->
      <div id="loading-state" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center text-gray-400">
        <svg class="w-6 h-6 animate-spin mx-auto mb-3 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4" stroke-linecap="round"/>
        </svg>
        Loading content…
      </div>

      <!-- Error state -->
      <div id="error-state" class="hidden bg-white rounded-2xl shadow-sm border border-gray-100 p-12 text-center text-gray-400">
        <p id="error-message" class="text-red-500 mb-3"></p>
        <a id="error-login-link" href="/admin" class="hidden text-brand-primary font-semibold hover:text-brand-olive transition-colors">
          Sign in again →
        </a>
      </div>

      <!-- Content editor -->
      <div id="content-root" class="hidden">
        <div id="tabs" class="flex flex-wrap gap-2 mb-6"></div>
        <div id="fields-container" class="space-y-6"></div>
      </div>

    </main>
  </div>

  <!-- Sticky save bar -->
  <div id="save-bar" class="hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-2xl px-6 py-4 z-40">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <span id="save-bar-count" class="text-sm font-semibold text-gray-600"></span>
      <div class="flex items-center gap-3">
        <button id="discard-btn" class="px-5 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition-colors">
          Discard
        </button>
        <button id="save-btn" class="inline-flex items-center gap-2 bg-brand-primary text-white px-6 py-2.5 rounded-xl font-bold text-sm hover:bg-brand-olive transition-colors">
          Save changes
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
const API = import.meta.env.PUBLIC_API_URL;
const token = () => sessionStorage.getItem('lv_id_token');

// ── Auth ──────────────────────────────────────────────────────────────────
document.getElementById('logout-btn').addEventListener('click', () => {
  sessionStorage.clear();
  window.location.href = '/admin';
});

try {
  const payload = JSON.parse(atob(token().split('.')[1]));
  const emailEl = document.getElementById('admin-email');
  emailEl.textContent = payload.email ?? '';
  emailEl.classList.remove('hidden');
} catch {}

// ── Status banner ─────────────────────────────────────────────────────────
function showStatus(msg, type = 'success') {
  const el = document.getElementById('status-banner');
  el.textContent = msg;
  el.className = `mb-6 p-4 rounded-xl text-sm font-medium ${
    type === 'success' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800'
  }`;
  el.classList.remove('hidden');
  setTimeout(() => el.classList.add('hidden'), 4000);
}

function esc(str) {
  return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function humanize(seg) {
  const s = String(seg ?? '').replace(/_/g, ' ');
  return s.charAt(0).toUpperCase() + s.slice(1);
}

// ── State ─────────────────────────────────────────────────────────────────
let schema = [];       // full schema from the API
let activePageId = null;
let draft = {};         // { [key]: newValue } for the active page only

function currentValue(field) {
  return Object.prototype.hasOwnProperty.call(draft, field.key) ? draft[field.key] : field.value;
}

// ── Fetch ─────────────────────────────────────────────────────────────────
async function fetchSchema() {
  const res = await fetch(`${API}/content/schema`, {
    headers: { Authorization: `Bearer ${token()}` },
  });
  if (res.status === 401) throw new Error('401');
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

async function init() {
  try {
    schema = await fetchSchema();
    document.getElementById('loading-state').classList.add('hidden');
    document.getElementById('content-root').classList.remove('hidden');

    const hashId = location.hash.replace('#', '');
    activePageId = schema.some(p => p.id === hashId) ? hashId : schema[0]?.id ?? null;
    if (activePageId) location.hash = activePageId;

    renderTabs();
    renderFields();
  } catch (err) {
    document.getElementById('loading-state').classList.add('hidden');
    document.getElementById('error-state').classList.remove('hidden');
    if (err.message === '401') {
      document.getElementById('error-message').textContent = 'Your session has expired. Please sign in again.';
      document.getElementById('error-login-link').classList.remove('hidden');
    } else {
      document.getElementById('error-message').textContent = `Failed to load content: ${err.message}`;
    }
  }
}

// ── Tabs ──────────────────────────────────────────────────────────────────
function renderTabs() {
  const tabsEl = document.getElementById('tabs');
  tabsEl.innerHTML = schema.map(p => `
    <button
      type="button"
      class="tab-btn px-4 py-2 rounded-xl text-sm font-semibold transition-colors ${
        p.id === activePageId ? 'bg-brand-primary text-white' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'
      }"
      data-tab-id="${esc(p.id)}"
    >${esc(p.label)}</button>
  `).join('');

  tabsEl.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tabId));
  });
}

function switchTab(id) {
  if (id === activePageId) return;
  if (Object.keys(draft).length > 0) {
    const ok = confirm('You have unsaved changes on this page. Discard them and switch pages?');
    if (!ok) return;
  }
  draft = {};
  activePageId = id;
  location.hash = id;
  renderTabs();
  renderFields();
  refreshSaveBar();
}

// ── Field rendering ───────────────────────────────────────────────────────
function renderFields() {
  const page = schema.find(p => p.id === activePageId);
  const container = document.getElementById('fields-container');
  if (!page) { container.innerHTML = ''; return; }

  const groups = [];
  const groupMap = new Map();
  for (const field of page.fields) {
    const seg = field.key.split('.')[1] ?? '';
    if (!groupMap.has(seg)) {
      const g = { title: humanize(seg), fields: [] };
      groupMap.set(seg, g);
      groups.push(g);
    }
    groupMap.get(seg).fields.push(field);
  }

  container.innerHTML = groups.map(g => `
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-heading font-bold text-brand-dark mb-4">${esc(g.title)}</h2>
      <div class="divide-y divide-gray-50">
        ${g.fields.map(fieldRowHTML).join('')}
      </div>
    </div>
  `).join('');

  attachFieldListeners(page);
}

function fieldRowHTML(field) {
  const value = currentValue(field);
  const isDefault = value === field.default;
  const resetBtn = `<button type="button" class="reset-link text-xs text-brand-primary hover:text-brand-olive font-medium ${isDefault ? 'hidden' : ''}" data-reset-key="${esc(field.key)}">Reset to default</button>`;

  let inputHtml;
  if (field.type === 'textarea') {
    inputHtml = `<textarea rows="3" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-primary text-sm text-gray-800 bg-white resize-none overflow-hidden" data-input-key="${esc(field.key)}">${esc(value)}</textarea>`;
  } else if (field.type === 'image') {
    inputHtml = `
      <div class="space-y-3">
        <img data-preview-key="${esc(field.key)}" src="${esc(value)}" class="h-40 object-cover rounded-lg border border-gray-100 bg-gray-50 ${value ? '' : 'hidden'}" alt="${esc(field.label)}" />
        <div class="image-drop border-2 border-dashed border-gray-200 rounded-xl p-5 text-center hover:border-brand-primary transition-colors cursor-pointer" data-drop-key="${esc(field.key)}">
          <svg class="w-6 h-6 mx-auto mb-1.5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <p class="text-sm text-gray-400">Click or drag to upload</p>
          <input type="file" accept="image/*" class="hidden" data-file-key="${esc(field.key)}" />
        </div>
        <p class="upload-status text-xs text-gray-400 min-h-[1em]" data-status-key="${esc(field.key)}"></p>
        <input type="text" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs text-gray-500 bg-white" data-input-key="${esc(field.key)}" value="${esc(value)}" placeholder="Image URL" />
      </div>`;
  } else {
    inputHtml = `<input type="text" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-primary text-sm text-gray-800 bg-white" data-input-key="${esc(field.key)}" value="${esc(value)}" />`;
  }

  return `
    <div class="field-row py-4 first:pt-0 last:pb-0" data-field-key="${esc(field.key)}">
      <div class="flex items-center justify-between gap-3 mb-1.5">
        <label class="text-sm font-semibold text-gray-700">${esc(field.label)}</label>
        ${resetBtn}
      </div>
      ${inputHtml}
    </div>`;
}

function attachFieldListeners(page) {
  const fieldsByKey = new Map(page.fields.map(f => [f.key, f]));

  document.querySelectorAll('#fields-container [data-input-key]').forEach(el => {
    if (el.tagName === 'TEXTAREA') autoGrow(el);
    el.addEventListener('input', () => {
      const field = fieldsByKey.get(el.dataset.inputKey);
      if (!field) return;
      if (el.tagName === 'TEXTAREA') autoGrow(el);
      updateDraft(field.key, el.value, field);
      if (field.type === 'image') {
        const preview = document.querySelector(`[data-preview-key="${field.key}"]`);
        if (preview) {
          if (el.value) { preview.src = el.value; preview.classList.remove('hidden'); }
          else { preview.classList.add('hidden'); }
        }
      }
    });
  });

  document.querySelectorAll('#fields-container .reset-link').forEach(btn => {
    btn.addEventListener('click', () => resetField(btn.dataset.resetKey, fieldsByKey));
  });

  document.querySelectorAll('#fields-container [data-drop-key]').forEach(drop => {
    const key = drop.dataset.dropKey;
    const fileInput = drop.querySelector('[data-file-key]');
    drop.addEventListener('click', () => fileInput.click());
    drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('border-brand-primary'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('border-brand-primary'));
    drop.addEventListener('drop', e => {
      e.preventDefault();
      drop.classList.remove('border-brand-primary');
      if (e.dataTransfer.files[0]) handleImageUpload(key, e.dataTransfer.files[0], fieldsByKey);
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files[0]) handleImageUpload(key, fileInput.files[0], fieldsByKey);
    });
  });
}

function autoGrow(el) {
  el.style.height = 'auto';
  el.style.height = `${el.scrollHeight}px`;
}

function setFieldDisplayValue(key, value) {
  const input = document.querySelector(`[data-input-key="${key}"]`);
  if (input) {
    input.value = value;
    if (input.tagName === 'TEXTAREA') autoGrow(input);
  }
  const preview = document.querySelector(`[data-preview-key="${key}"]`);
  if (preview) {
    if (value) { preview.src = value; preview.classList.remove('hidden'); }
    else { preview.classList.add('hidden'); }
  }
}

function resetField(key, fieldsByKey) {
  const field = fieldsByKey.get(key);
  if (!field) return;
  setFieldDisplayValue(key, field.default);
  updateDraft(key, field.default, field);
}

function updateDraft(key, value, field) {
  if (value === field.value) delete draft[key]; else draft[key] = value;
  const resetBtn = document.querySelector(`.reset-link[data-reset-key="${key}"]`);
  if (resetBtn) resetBtn.classList.toggle('hidden', value === field.default);
  refreshSaveBar();
}

function refreshSaveBar() {
  const count = Object.keys(draft).length;
  const bar = document.getElementById('save-bar');
  if (count === 0) { bar.classList.add('hidden'); return; }
  bar.classList.remove('hidden');
  document.getElementById('save-bar-count').textContent = `${count} unsaved change${count === 1 ? '' : 's'}`;
}

// ── Image upload ──────────────────────────────────────────────────────────
async function handleImageUpload(key, file, fieldsByKey) {
  const statusEl = document.querySelector(`[data-status-key="${key}"]`);
  setUploadStatus(statusEl, 'Uploading…');
  try {
    const contentType = file.type || 'application/octet-stream';
    const urlRes = await fetch(`${API}/upload-url`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` },
      body: JSON.stringify({ filename: file.name, contentType, folder: 'content' }),
    });
    if (!urlRes.ok) throw new Error(`Upload URL request failed: HTTP ${urlRes.status}`);
    const { uploadUrl, publicUrl } = await urlRes.json();

    const putRes = await fetch(uploadUrl, {
      method: 'PUT',
      headers: { 'Content-Type': contentType },
      body: file,
    });
    if (!putRes.ok) throw new Error(`Upload failed: HTTP ${putRes.status}`);

    const field = fieldsByKey.get(key);
    setFieldDisplayValue(key, publicUrl);
    if (field) updateDraft(key, publicUrl, field);
    setUploadStatus(statusEl, '✓ Uploaded');
  } catch (err) {
    setUploadStatus(statusEl, `Upload failed: ${err.message}`, true);
  }
}

function setUploadStatus(el, msg, isError = false) {
  if (!el) return;
  el.textContent = msg;
  el.className = `upload-status text-xs mt-1.5 min-h-[1em] ${isError ? 'text-red-500' : 'text-green-600'}`;
}

// ── Save / discard ────────────────────────────────────────────────────────
document.getElementById('discard-btn').addEventListener('click', () => {
  draft = {};
  renderFields();
  refreshSaveBar();
});

document.getElementById('save-btn').addEventListener('click', async () => {
  if (Object.keys(draft).length === 0) return;
  const btn = document.getElementById('save-btn');
  btn.disabled = true;
  btn.textContent = 'Saving…';
  try {
    const res = await fetch(`${API}/content`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` },
      body: JSON.stringify({ values: draft }),
    });
    if (!res.ok) {
      const errBody = await res.json().catch(() => ({}));
      throw new Error(errBody.error || `HTTP ${res.status}`);
    }
    schema = await fetchSchema();
    draft = {};
    renderTabs();
    renderFields();
    showStatus('Changes saved. They appear on the site within a minute.');
  } catch (err) {
    showStatus(`Save failed: ${err.message}`, 'error');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Save changes';
    refreshSaveBar();
  }
});

init();
</script>
