---
import Icon from './Icon.astro';
import { getContent } from '../data/content';

const c = await getContent();

const cards = [
  { icon: 'people', key: 'card1' },
  { icon: 'camera', key: 'card2' },
  { icon: 'compass', key: 'card3' },
];
---

<section id="community" class="py-20 bg-brand-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
    <span class="inline-block text-xs font-bold text-brand-gold uppercase tracking-widest mb-3" data-c="home.community.tagline">{c['home.community.tagline']}</span>
    <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4" data-c="home.community.heading">{c['home.community.heading']}</h2>
    <p class="text-white/80 max-w-2xl mx-auto mb-12 leading-relaxed" data-c="home.community.desc" data-c-multiline>
      {c['home.community.desc']}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left mb-14">
      {cards.map(item => (
        <div class="bg-white/10 rounded-2xl p-6 hover:bg-white/15 transition-colors">
          <div class="mb-4 text-brand-lime">
            <Icon name={item.icon} class="w-12 h-12" />
          </div>
          <h3 class="font-heading font-bold text-lg text-brand-lime mb-2" data-c={`home.community.${item.key}.title`}>{c[`home.community.${item.key}.title`]}</h3>
          <p class="text-white/75 text-sm leading-relaxed" data-c={`home.community.${item.key}.desc`} data-c-multiline>{c[`home.community.${item.key}.desc`]}</p>
        </div>
      ))}
    </div>

    <a href="/contact" class="btn-primary bg-brand-gold text-brand-dark hover:bg-yellow-400 text-base px-10 py-4 inline-block" data-c="home.community.cta">
      {c['home.community.cta']}
    </a>
  </div>
</section>
