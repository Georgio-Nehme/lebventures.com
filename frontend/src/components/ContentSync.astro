---
// Refreshes editable content in the DOM after hydration, so admin edits
// show up without a rebuild. Safe no-op when PUBLIC_API_URL is unset, and
// any failure is swallowed — the build-time defaults already rendered.
const apiUrl = import.meta.env.PUBLIC_API_URL as string | undefined;
---

{apiUrl && (
  <script define:vars={{ apiUrl }}>
    (function () {
      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function toHtmlLines(value) {
        return escapeHtml(value).replace(/\n/g, '<br />');
      }

      function apply(content) {
        document.querySelectorAll('[data-c]').forEach((el) => {
          const key = el.getAttribute('data-c');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            const value = content[key];
            if (el.textContent !== value) el.textContent = value;
          }
        });

        document.querySelectorAll('[data-c-html]').forEach((el) => {
          const key = el.getAttribute('data-c-html');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            const html = toHtmlLines(content[key]);
            if (el.innerHTML !== html) el.innerHTML = html;
          }
        });

        document.querySelectorAll('[data-c-src]').forEach((el) => {
          const key = el.getAttribute('data-c-src');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            const value = content[key];
            if (el.getAttribute('src') !== value) el.setAttribute('src', value);
            el.hidden = !value;
          }
        });

        // Overlays that pair with a [data-c-src] image (e.g. a darkening
        // scrim) but aren't an <img> themselves — shown only when the image
        // key has a value.
        document.querySelectorAll('[data-c-src-overlay]').forEach((el) => {
          const key = el.getAttribute('data-c-src-overlay');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            el.hidden = !content[key];
          }
        });

        document.querySelectorAll('[data-c-href]').forEach((el) => {
          const key = el.getAttribute('data-c-href');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            const prefix = el.getAttribute('data-c-prefix') || '';
            const value = content[key];
            const href = prefix + value;
            if (el.getAttribute('href') !== href) el.setAttribute('href', href);

            // mailto:/tel: anchors (identified by data-c-prefix) are never
            // external-link buttons — leave their target/rel alone.
            if (!el.hasAttribute('data-c-prefix')) {
              if (typeof value === 'string' && value.startsWith('http')) {
                if (el.getAttribute('target') !== '_blank') el.setAttribute('target', '_blank');
                if (el.getAttribute('rel') !== 'noopener noreferrer') el.setAttribute('rel', 'noopener noreferrer');
              } else {
                if (el.hasAttribute('target')) el.removeAttribute('target');
                if (el.hasAttribute('rel')) el.removeAttribute('rel');
              }
            }
          }
        });

        // Anchors that can be switched to non-clickable
        document.querySelectorAll('[data-c-link]').forEach((el) => {
          const key = el.getAttribute('data-c-link');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            const clickable = content[key] !== 'false';
            const target = el.getAttribute('data-href') || el.getAttribute('href') || '';
            if (!clickable) {
              if (el.hasAttribute('href')) el.setAttribute('data-href', el.getAttribute('href'));
              el.removeAttribute('href');
              el.removeAttribute('target');
              el.removeAttribute('rel');
              el.setAttribute('aria-disabled', 'true');
            } else if (!el.hasAttribute('href') && target) {
              el.setAttribute('href', target);
              el.removeAttribute('aria-disabled');
              if (/^https?:/.test(target)) { el.setAttribute('target', '_blank'); el.setAttribute('rel', 'noopener noreferrer'); }
            }
          }
        });

        // Grid column count (select field, values '2'/'3'/'4') — swap the
        // matching lg:grid-cols-N class.
        document.querySelectorAll('[data-c-cols]').forEach((el) => {
          const key = el.getAttribute('data-c-cols');
          if (!key || !Object.prototype.hasOwnProperty.call(content, key)) return;
          const value = content[key];
          el.classList.remove('lg:grid-cols-2', 'lg:grid-cols-3', 'lg:grid-cols-4');
          if (value) el.classList.add('lg:grid-cols-' + value);
        });

        // Repeatable cards (icon, title, tag, desc), stored as a JSON array.
        document.querySelectorAll('[data-c-cards]').forEach((container) => {
          const key = container.getAttribute('data-c-cards');
          if (!key || !Object.prototype.hasOwnProperty.call(content, key)) return;

          let items;
          try {
            items = JSON.parse(content[key] || '[]');
          } catch {
            return;
          }
          if (!Array.isArray(items)) return;

          const normalized = items.map((item) => ({
            icon: typeof (item && item.icon) === 'string' ? item.icon : '',
            title: typeof (item && item.title) === 'string' ? item.title : '',
            tag: typeof (item && item.tag) === 'string' ? item.tag : '',
            desc: typeof (item && item.desc) === 'string' ? item.desc : '',
          }));

          function cardIcon(card) {
            const wrapper = card.querySelector('[data-icon]');
            return wrapper ? wrapper.getAttribute('data-icon') || '' : '';
          }
          function cardText(card, attr) {
            const el = card.matches('[' + attr + ']') ? card : card.querySelector('[' + attr + ']');
            return el ? el.textContent.trim() : '';
          }

          const cardEls = Array.from(container.querySelectorAll('[data-card]'));
          const current = cardEls.map((card) => ({
            icon: cardIcon(card),
            title: cardText(card, 'data-card-title'),
            tag: cardText(card, 'data-card-tag'),
            desc: cardText(card, 'data-card-desc'),
          }));

          const same =
            current.length === normalized.length &&
            current.every((cur, i) =>
              cur.icon === normalized[i].icon &&
              cur.title === normalized[i].title &&
              cur.tag === normalized[i].tag &&
              cur.desc === normalized[i].desc
            );
          if (same) return;

          const template = cardEls[0];
          if (!template) return;
          const templateClone = template.cloneNode(true);

          // Preserve rendered icon markup so a rebuild doesn't lose inline
          // SVGs for icons that are still present.
          const iconMap = {};
          cardEls.forEach((card) => {
            const wrapper = card.querySelector('[data-icon]');
            if (!wrapper) return;
            const name = wrapper.getAttribute('data-icon') || '';
            if (name && !Object.prototype.hasOwnProperty.call(iconMap, name)) {
              iconMap[name] = wrapper.innerHTML;
            }
          });

          container.innerHTML = '';
          normalized.forEach((item) => {
            const clone = templateClone.cloneNode(true);
            const titleEl = clone.querySelector('[data-card-title]');
            if (titleEl) titleEl.textContent = item.title;
            const tagEl = clone.querySelector('[data-card-tag]');
            if (tagEl) { tagEl.textContent = item.tag; tagEl.hidden = !item.tag; }
            const descEl = clone.querySelector('[data-card-desc]');
            if (descEl) descEl.textContent = item.desc;
            const iconEl = clone.querySelector('[data-icon]');
            if (iconEl) {
              iconEl.setAttribute('data-icon', item.icon);
              iconEl.innerHTML = Object.prototype.hasOwnProperty.call(iconMap, item.icon)
                ? iconMap[item.icon]
                : '';
            }
            container.appendChild(clone);
          });
        });

        // Elements that should hide once a paired key (e.g. a replacement
        // image) has a value.
        document.querySelectorAll('[data-c-hide-when-set]').forEach((el) => {
          const key = el.getAttribute('data-c-hide-when-set');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            el.hidden = !!content[key];
          }
        });

        document.querySelectorAll('[data-c-show]').forEach((el) => {
          const key = el.getAttribute('data-c-show');
          if (key && Object.prototype.hasOwnProperty.call(content, key)) {
            const shouldHide = content[key] === 'false';
            if (el.hidden !== shouldHide) el.hidden = shouldHide;
          }
        });

        // Editable lists (newline-separated): rebuild the container's
        // children from its first child as a template, one clone per item.
        document.querySelectorAll('[data-c-list]').forEach((container) => {
          const key = container.getAttribute('data-c-list');
          if (!key || !Object.prototype.hasOwnProperty.call(content, key)) return;

          const items = String(content[key] || '')
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean);

          const template = container.firstElementChild;
          if (!template) return;

          function markers(el, attr) {
            const found = [];
            if (el.matches && el.matches('[' + attr + ']')) found.push(el);
            found.push(...el.querySelectorAll('[' + attr + ']'));
            return found;
          }

          function currentItems() {
            return Array.from(container.children).map((child) => {
              const textEls = markers(child, 'data-c-list-text');
              if (textEls.length) return textEls.map((t) => t.textContent.trim()).join('');
              return child.textContent.trim();
            });
          }

          const current = currentItems();
          const same =
            current.length === items.length && current.every((t, i) => t === items[i]);
          if (same) return;

          const templateClone = template.cloneNode(true);
          container.innerHTML = '';
          items.forEach((item) => {
            const clone = templateClone.cloneNode(true);
            const textEls = markers(clone, 'data-c-list-text');
            if (textEls.length) {
              textEls.forEach((t) => { t.textContent = item; });
            } else {
              clone.textContent = item;
            }
            markers(clone, 'data-c-list-value').forEach((v) => {
              v.value = item;
              if ('checked' in v) v.checked = false;
            });
            container.appendChild(clone);
          });
        });
      }

      // Browser-side cache: reuse the last fetched content for CACHE_MS so a
      // refresh or navigating between pages doesn't re-request /content.
      const CACHE_KEY = 'lv_content_cache';
      const CACHE_MS = 5 * 60 * 1000;

      function readCache() {
        try {
          const raw = localStorage.getItem(CACHE_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (!parsed || typeof parsed.ts !== 'number' || !parsed.data) return null;
          if (Date.now() - parsed.ts > CACHE_MS) return null;
          return parsed.data;
        } catch { return null; }
      }

      function writeCache(data) {
        try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data })); } catch {}
      }

      try {
        const cached = readCache();
        if (cached) {
          apply(cached);
          return;
        }
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 5000);
        fetch(apiUrl + '/content', { signal: controller.signal })
          .then((res) => {
            clearTimeout(timer);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
          })
          .then((json) => { writeCache(json || {}); apply(json || {}); })
          .catch((err) => console.warn('[content-sync] skipped:', err));
      } catch (err) {
        console.warn('[content-sync] skipped:', err);
      }
    })();
  </script>
)}
