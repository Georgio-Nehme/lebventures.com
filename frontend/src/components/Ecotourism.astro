---
import Icon from './Icon.astro';
import { getContent, show } from '../data/content';

const c = await getContent();

// Icons are not editable; text comes from content by index.
const PILLAR_ICONS = ['leaf', 'house', 'cedar', 'book'];
const pillars = PILLAR_ICONS.map((icon, i) => {
  const n = i + 1;
  return {
    icon,
    n,
    title: c[`sustainability.pillar${n}.title`],
    description: c[`sustainability.pillar${n}.desc`],
  };
});
---

<section id="sustainable-tourism" class="py-20 bg-brand-sky/30" data-c-show="sustainability.intro.show" hidden={!show(c, 'sustainability.intro.show')}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Text side -->
      <div>
        <span class="inline-block text-xs font-bold text-brand-primary uppercase tracking-widest mb-3">Our Commitment</span>
        <h2 class="section-heading" data-c="sustainability.intro.heading">{c['sustainability.intro.heading']}</h2>
        <p class="text-gray-600 leading-relaxed mb-8" data-c="sustainability.intro.text" data-c-multiline>
          {c['sustainability.intro.text']}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6" data-c-show="sustainability.pillars.show" hidden={!show(c, 'sustainability.pillars.show')}>
          {pillars.map(p => (
            <div data-c-show={`sustainability.pillar${p.n}.show`} hidden={!show(c, `sustainability.pillar${p.n}.show`)}>
              <h4 class="font-heading font-bold text-brand-primary text-base mb-1" data-c={`sustainability.pillar${p.n}.title`}>{p.title}</h4>
              <p class="text-sm text-gray-600 leading-relaxed" data-c={`sustainability.pillar${p.n}.desc`} data-c-multiline>{p.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Visual side -->
      <div class="relative">
        <img
          src={c['sustainability.quote.image'] || undefined}
          alt=""
          class="w-full rounded-3xl shadow-2xl object-cover"
          data-c-src="sustainability.quote.image"
          hidden={!c['sustainability.quote.image']}
          loading="lazy"
        />
        <div
          class="bg-brand-primary rounded-3xl p-10 text-white text-center shadow-2xl"
          data-c-hide-when-set="sustainability.quote.image"
          hidden={!!c['sustainability.quote.image']}
        >
          <div class="flex justify-center mb-6 opacity-80">
            <Icon name="mountain" class="w-20 h-20 text-white" />
          </div>
          <blockquote class="text-xl font-heading italic leading-relaxed mb-6">
            "<span data-c="sustainability.quote.text" data-c-multiline>{c['sustainability.quote.text']}</span>"
          </blockquote>
          <div class="flex items-center justify-center gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-gold flex items-center justify-center text-brand-dark font-bold text-sm">
              LV
            </div>
            <div class="text-left">
              <div class="font-bold text-sm" data-c="sustainability.quote.author">{c['sustainability.quote.author']}</div>
              <div class="text-brand-sky text-xs" data-c="sustainability.quote.role">{c['sustainability.quote.role']}</div>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-4 -right-4 w-24 h-24 rounded-full bg-brand-gold/20 -z-10"></div>
        <div class="absolute -top-4 -left-4 w-16 h-16 rounded-full bg-brand-lime/30 -z-10"></div>
      </div>
    </div>
  </div>
</section>
