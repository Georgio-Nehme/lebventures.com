---
import Icon from './Icon.astro';
import { getContent, show, isExternalHref, cardsOf } from '../data/content';

const c = await getContent();

const adventures = cardsOf(c, 'adventures.cards');

// Desktop column count is admin-editable; all three classes must appear
// literally in source so Tailwind generates them.
const COLS_CLASS: Record<string, string> = {
  '2': 'lg:grid-cols-2',
  '3': 'lg:grid-cols-3',
  '4': 'lg:grid-cols-4',
};
const colsClass = COLS_CLASS[c['adventures.cards.columns']] || COLS_CLASS['3'];
---

<section id="adventures" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="section-heading" data-c="adventures.section.heading">{c['adventures.section.heading']}</h2>
      <p class="section-subheading mx-auto" data-c="adventures.section.subheading" data-c-multiline>
        {c['adventures.section.subheading']}
      </p>
    </div>

    <div class={`grid grid-cols-1 sm:grid-cols-2 ${colsClass} gap-8`} data-c-cards="adventures.cards" data-c-cols="adventures.cards.columns">
      {adventures.map(adv => (
        <div class="p-6 rounded-2xl border border-brand-sky bg-white" data-card>
          <div class="mb-4 text-brand-primary" data-icon={adv.icon}>
            {adv.icon && <Icon name={adv.icon} class="w-14 h-14" />}
          </div>
          <span class="inline-block text-xs font-bold bg-brand-sky text-brand-olive px-3 py-1 rounded-full mb-3 uppercase tracking-wider" data-card-tag>
            {adv.tag}
          </span>
          <h3 class="text-xl font-heading font-bold text-brand-primary mb-2" data-card-title>
            {adv.title}
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed" data-card-desc data-c-multiline>{adv.desc}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-12" data-c-show="adventures.section.cta.show" hidden={!show(c, 'adventures.section.cta.show')}>
      <a
        href={c['adventures.section.cta.href']}
        class="btn-primary"
        data-c="adventures.section.cta"
        data-c-href="adventures.section.cta.href"
        target={isExternalHref(c['adventures.section.cta.href']) ? '_blank' : undefined}
        rel={isExternalHref(c['adventures.section.cta.href']) ? 'noopener noreferrer' : undefined}
      >{c['adventures.section.cta']}</a>
    </div>
  </div>
</section>
