---
import Icon from './Icon.astro';
import { getContent } from '../data/content';

const c = await getContent();

// Icons are not editable; only title/description/tag come from content.
const ICONS = ['hiking', 'climbing', 'camping', 'water', 'snow', 'leisure', 'biking', 'kids', 'heritage'];

const adventures = ICONS.map((icon, i) => {
  const n = i + 1;
  return {
    icon,
    title: c[`adventures.card${n}.title`],
    description: c[`adventures.card${n}.desc`],
    tag: c[`adventures.card${n}.tag`],
    n,
  };
});
---

<section id="adventures" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="section-heading" data-c="adventures.section.heading">{c['adventures.section.heading']}</h2>
      <p class="section-subheading mx-auto" data-c="adventures.section.subheading" data-c-multiline>
        {c['adventures.section.subheading']}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {adventures.map(adv => (
        <div class="group p-6 rounded-2xl border border-brand-sky bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 text-brand-primary">
            <Icon name={adv.icon} class="w-14 h-14" />
          </div>
          <span class="inline-block text-xs font-bold bg-brand-sky text-brand-olive px-3 py-1 rounded-full mb-3 uppercase tracking-wider" data-c={`adventures.card${adv.n}.tag`}>
            {adv.tag}
          </span>
          <h3 class="text-xl font-heading font-bold text-brand-primary mb-2 group-hover:text-brand-olive transition-colors" data-c={`adventures.card${adv.n}.title`}>
            {adv.title}
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed" data-c={`adventures.card${adv.n}.desc`} data-c-multiline>{adv.description}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/contact" class="btn-primary" data-c="adventures.section.cta">{c['adventures.section.cta']}</a>
    </div>
  </div>
</section>
